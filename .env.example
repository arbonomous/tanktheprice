# =============================================================================
# HormuzFlow — Environment Configuration
# Copy to .env.local (zero-key mode works out of the box with free feeds + seed)
# =============================================================================

# Feed orchestration mode:
#   auto      -> Uses paid AIS keys if set, else tries free live feeds (Hormuz.now,
#                IMF PortWatch, yfinance) and seamlessly falls back to deterministic simulator.
#   live      -> Prefer live feeds whenever reachable.
#   simulator -> Deterministic offline 45-day simulator mode.
FEED_MODE=auto

# Optional Free Real-Time WebSocket AIS (aisstream.io — free GitHub login key)
AISSTREAM_API_KEY=

# Optional High-Resolution Maritime AIS API Keys
# Leave blank to run in zero-key default mode.
STRAITS_LIVE_API_KEY=
DATALASTIC_API_KEY=
MARINETRAFFIC_API_KEY=

# Optional Oil Market Data API Keys
# Leave blank to use free yfinance (BZ=F Brent Crude & CL=F WTI Crude).
ALPHAVANTAGE_API_KEY=

# Backend & Database
DATABASE_URL=sqlite:///./data/hormuzflow.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
REFRESH_INTERVAL_SECONDS=300

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
